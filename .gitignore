################################
### Xcode project .gitignore ###
################################

### macOS ###

.DS_Store

### User settings and such ###

xcuserdata/
*.xcworkspace
!default.xcworkspace

### Build Artifacts ###

*.hmap
*.ipa
*.dSYM.zip
*.dSYM

*.xcworkspace
!default.xcworkspace
xcuserdata
profile
*.moved-aside
DerivedData
.idea/
*.xccheckout
build/

### Swift Package Manager ###

.swiftpm/xcode/package.xcworkspace/contents.xcworkspacedata
.build/

### Playgrounds ###

timeline.xctimeline
playground.xcworkspace

### Hermes runtime artifacts (kept out of repo) ###
**/__pycache__/
hermes/whatsapp-ingest/node_modules/
hermes/whatsapp-ingest/auth/
hermes/hooks/*/\.state.json

### Build / coverage artifacts ###
Geo/build-iso/
Geo/*.xcresult/
Geo/default.profraw
*.profraw

### Secrets / credentials (never commit) ###
.env
*.env
!*.env.template
auth.json
*credentials*
*_priv.pem
dsa_priv.pem
sparkle_priv*
*.p12

### Personal vault / runtime data (lives outside the repo — guard against copy-in) ###
Blocks/
Captures/
days.json
tags.json
*.sqlite
*.sqlite-wal
*.sqlite-shm
Index/
status.json

### Stray local artifacts ###
test_hash
.brain
