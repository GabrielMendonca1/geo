<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.hermes.geo-mcp-subscriber</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HERMES_PYTHON__</string>
    <string>__DAEMON_PATH__</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HERMES_HOME__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HERMES_HOME__/logs/geo-mcp-subscriber.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HERMES_HOME__/logs/geo-mcp-subscriber.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>HERMES_HOME</key>
    <string>__HERMES_HOME__</string>
  </dict>
</dict>
</plist>
