<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.hermes.claude-code-lane</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HERMES_PYTHON__</string>
    <string>__DAEMON_PATH__</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HERMES_HOME__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__HERMES_HOME__/logs/claude-code-lane.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HERMES_HOME__/logs/claude-code-lane.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>HERMES_HOME</key>
    <string>__HERMES_HOME__</string>
    <key>CLAUDE_CODE_BIN</key>
    <string>__CLAUDE_BIN__</string>
    <key>CLAUDE_CODE_PERMISSION_MODE</key>
    <string>acceptEdits</string>
  </dict>
</dict>
</plist>
