# hermes — runtime env
# Copy to ~/.hermes/.env and fill in. install.sh will copy this for you only
# if ~/.hermes/.env does not already exist (we never overwrite secrets).

# --- Core ---
HERMES_HOME=~/.hermes
ANTHROPIC_API_KEY=

# --- API server (local control plane) ---
API_SERVER_ENABLED=1
# Generate with:  openssl rand -hex 32
API_SERVER_KEY=

# --- MCP bridge ---
# Resolved by install.sh from $REPO_ROOT/geo-mcp-bridge/geo-mcp-bridge.
# Mirrored into ~/.hermes/config.yaml at install time; kept here for reference
# and for daemons that read .env directly.
GEO_MCP_BRIDGE_BIN=

# --- Platforms ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_HOME_CHANNEL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_OAUTH_TOKEN=
# WhatsApp uses Baileys multi-file auth at ~/.hermes/whatsapp-ingest/auth/.
# No env var; first run prints a QR in the launchd stdout log.

# --- Locale ---
TZ=America/Sao_Paulo

# --- geo-claw -> hermes env var mapping ---
# Old name (geo-claw)               -> New name (hermes)
#   GEO_CLAW_TZ                     -> TZ
#   GEO_CLAW_MCP_BRIDGE_PATH        -> set in config.yaml mcp_servers.geo.command
#   GEO_CLAW_GOOGLE_CLIENT_ID       -> GOOGLE_CLIENT_ID
#   GEO_CLAW_GOOGLE_CLIENT_SECRET   -> GOOGLE_CLIENT_SECRET
#   ANTHROPIC_API_KEY               -> ANTHROPIC_API_KEY (unchanged)
