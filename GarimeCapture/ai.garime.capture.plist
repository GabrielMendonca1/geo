<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.garime.capture</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/biel/.local/bin/garimecapture</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardErrorPath</key>
	<string>/Users/biel/Library/Logs/garime/garimecapture.err</string>
	<key>StandardOutPath</key>
	<string>/Users/biel/Library/Logs/garime/garimecapture.out</string>
</dict>
</plist>
