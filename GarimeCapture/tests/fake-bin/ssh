#!/bin/sh
{
  echo "--- ssh ---"
  for a in "$@"; do echo "arg: $a"; done
} >> "$GARIME_FAKE_LOG"

[ -n "${GARIME_FAKE_SLEEP:-}" ] && sleep "$GARIME_FAKE_SLEEP"

if [ -n "${GARIME_FAKE_FAIL_TIMES:-}" ]; then
  count=$(cat "$GARIME_FAKE_COUNTER" 2>/dev/null || echo 0)
  if [ "$count" -lt "$GARIME_FAKE_FAIL_TIMES" ]; then
    echo $((count + 1)) > "$GARIME_FAKE_COUNTER"
    exit 255
  fi
fi

[ "${GARIME_FAKE_EXIT:-0}" != "0" ] && exit "$GARIME_FAKE_EXIT"

cmd=""
for a in "$@"; do cmd="$a"; done
sh -c "$cmd"
