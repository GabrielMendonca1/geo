# Configuração da instância única garime-agent — único lugar para ajustar.
# Sourced por garime-agent-launch.sh e garime-agent-reset.sh; overrides das defaults.

GARIME_AGENT_SESSION=garime-agent
GARIME_AGENT_TMUX=/usr/bin/tmux
GARIME_AGENT_BIN=/home/biel/.local/bin/pi
GARIME_AGENT_WORKDIR=/mnt/garime/Gabriel
# subdir com o cwd mangleado — é onde o bridge (agent_pi_dir) procura o transcript
GARIME_AGENT_SESSION_DIR=/mnt/garime/pi/agent/sessions/--mnt-garime-Vault--
GARIME_AGENT_PROMPT=/opt/garime/agent/system-prompt.md
GARIME_AGENT_TOOLS=read,write,edit,bash
GARIME_AGENT_PROVIDER=anthropic
GARIME_AGENT_MODEL=claude-sonnet-4-6
GARIME_AGENT_THINKING=medium
